# ============================================
# FixBari - Environment Configuration
# ============================================

# Database
DATABASE_URL=postgresql://localservices:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/localservices
POSTGRES_USER=localservices
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=localservices

# RabbitMQ
RABBITMQ_URL=amqp://admin:REPLACE_WITH_STRONG_QUEUE_PASSWORD@localhost:5672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_STRONG_QUEUE_PASSWORD

# JWT
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHIC_RANDOM_SECRET
JWT_EXPIRATION=7d

# ============================================
# Traefik Proxy Configuration
# ============================================
# When running with Traefik (docker-compose up or local traefik):
# - All API calls go through http://localhost/api
# - Traefik routes to services based on path:
#   - /api/auth/*      -> Auth Service (port 3001)
#   - /api/orders/*    -> Orders Service (port 3003)
#   - /api/services/*  -> Services Service (port 3005)
#   - /api/notifications/* -> Notifications Service (port 3002)
#   - /api/payment/*   -> Payment Service (port 3004)

# Single API URL for all frontend apps (through Traefik)
NEXT_PUBLIC_API_URL=http://localhost/api

# ============================================
# Backend Services (for inter-service communication)
# ============================================
AUTH_SERVICE_URL=http://localhost:3001
NOTIFICATIONS_SERVICE_URL=http://localhost:3002
ORDERS_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
SERVICES_SERVICE_URL=http://localhost:3005

# ============================================
# Frontend App URLs
# ============================================
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost
NEXT_PUBLIC_TECHNICIAN_URL=http://technician.localhost

# ============================================
# Traefik Dashboard
# ============================================
# Access at: http://localhost:8080

PAYMENT_INTERNAL_TOKEN=replace-with-long-random-backend-only-value
PAYMENT_STATUS_URL=http://localhost:3004
RABBITMQ_PASSWORD=replace-with-queue-secret
# Frontend SSR rewrites to your OWN gateway; do not reuse any old Railway URL.
API_GATEWAY_ORIGIN=http://localhost
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_DJANGO_SECRET
SSL_STORE_ID=
SSL_STORE_PASSWORD=

# Google Identity Services (Google Cloud OAuth Web client ID)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
